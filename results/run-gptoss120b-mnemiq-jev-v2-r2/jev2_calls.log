BENCH-JEV status=200 latency_ms=190 model=jev-1.14.0 prompt=b input_tokens=2712 output_tokens=21 noul=0.46 q='For each day of the week in 2024, how many invoices were issued? Retur' sql="SELECT EXTRACT(DAYOFWEEK FROM invoice_date) AS day_of_week, COUNT(*) AS invoice_count FROM invoice WHERE invoice_date >= CAST('2024-01-01 00:00:00' AS TIMESTAMP) AND invoice_date < CAST('2025-01-01 00:00:00' AS TIMESTAMP) GROUP BY day_of_week ORDER BY day_of_week LIMIT 1000"
BENCH-JEV status=200 latency_ms=118 model=jev-1.14.0 prompt=b input_tokens=2829 output_tokens=21 noul=0.82 q='For each support representative, which customer has the highest total ' sql="WITH cust_spend AS (SELECT c.customer_id, c.first_name AS cust_first, c.last_name AS cust_last, c.support_rep_id, SUM(i.total) AS spend FROM customer AS c JOIN invoice AS i ON i.customer_id = c.customer_id GROUP BY c.customer_id, c.first_name, c.last_name, c.support_rep_id), rep_max AS (SELECT support_rep_id, MAX(spend) AS max_spend FROM cust_spend GROUP BY support_rep_id) SELECT e.first_name AS rep_first, e.last_name AS rep_last, cs.cust_first, cs.cust_last, cs.spend FROM cust_spend AS cs JOIN rep_max AS rm ON cs.support_rep_id = rm.support_rep_id AND cs.spend = rm.max_spend JOIN employee AS e ON e.employee_id = cs.support_rep_id ORDER BY e.employee_id, cs.cust_last, cs.cust_first LIMIT 1000"
BENCH-JEV status=200 latency_ms=168 model=jev-1.14.0 prompt=b input_tokens=3080 output_tokens=21 noul=0.89 q='Which artists have never had any track appear on an invoice line (neve' sql="SELECT a.name FROM artist AS a WHERE NOT EXISTS(SELECT 1 FROM album AS al JOIN track AS t ON t.album_id = al.album_id JOIN invoice_line AS il ON il.track_id = t.track_id WHERE al.artist_id = a.artist_id) ORDER BY a.name LIMIT 1000"
BENCH-JEV status=200 latency_ms=151 model=jev-1.14.0 prompt=b input_tokens=2715 output_tokens=21 noul=0.89 q='For each quarter of 2024, show the total invoice revenue and the previ' sql="SELECT q AS quarter, revenue, LAG(revenue) OVER (ORDER BY q) AS previous_quarter_revenue FROM (SELECT EXTRACT(QUARTER FROM invoice_date) AS q, SUM(total) AS revenue FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2024 GROUP BY EXTRACT(QUARTER FROM invoice_date)) AS t ORDER BY quarter LIMIT 1000"
BENCH-JEV status=200 latency_ms=334 model=jev-1.14.0 prompt=b input_tokens=2625 output_tokens=21 noul=0.19 q='Which ISO week numbers of 2023 had the highest invoice revenue? Return' sql="SELECT DATE_PART('week', invoice_date) AS week_number, SUM(total) AS revenue FROM invoice WHERE DATE_PART('year', invoice_date) = 2023 GROUP BY week_number ORDER BY revenue DESC LIMIT 3"
BENCH-JEV status=200 latency_ms=119 model=jev-1.14.0 prompt=b input_tokens=2563 output_tokens=21 noul=0.81 q='How many distinct billing postal codes appear on invoices billed to Ca' sql="SELECT COUNT(DISTINCT billing_postal_code) AS distinct_postal_codes FROM invoice WHERE billing_country = 'Canada' LIMIT 1000"
