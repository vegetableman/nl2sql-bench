BENCH-JEV status=200 latency_ms=195 model=jev-1.14.0 input_tokens=2745 output_tokens=21 noul=0.69 q='For each support representative, which customer has the highest total ' sql="WITH customer_spend AS (SELECT c.customer_id, c.support_rep_id, COALESCE(SUM(i.total), 0) AS spend FROM customer AS c LEFT JOIN invoice AS i ON c.customer_id = i.customer_id GROUP BY c.customer_id, c.support_rep_id), max_spend_per_rep AS (SELECT support_rep_id, MAX(spend) AS max_spend FROM customer_spend GROUP BY support_rep_id) SELECT e.first_name AS rep_first_name, e.last_name AS rep_last_name, cust.first_name AS cust_first_name, cust.last_name AS cust_last_name, cs.spend FROM customer_spend AS cs JOIN max_spend_per_rep AS ms ON cs.support_rep_id = ms.support_rep_id AND cs.spend = ms.max_spend JOIN employee AS e ON cs.support_rep_id = e.employee_id JOIN customer AS cust ON cs.customer_id = cust.customer_id ORDER BY e.employee_id LIMIT 1000"
BENCH-JEV status=200 latency_ms=180 model=jev-1.14.0 input_tokens=2577 output_tokens=21 noul=0.67 q='Which artists have never had any track appear on an invoice line (neve' sql="SELECT a.name FROM artist AS a WHERE NOT EXISTS(SELECT 1 FROM album AS al JOIN track AS t ON t.album_id = al.album_id JOIN invoice_line AS il ON il.track_id = t.track_id WHERE al.artist_id = a.artist_id) ORDER BY a.name LIMIT 1000"
BENCH-JEV status=200 latency_ms=158 model=jev-1.14.0 input_tokens=2625 output_tokens=21 noul=0.85 q='For each quarter of 2024, show the total invoice revenue and the previ' sql="WITH quarterly AS (SELECT EXTRACT(QUARTER FROM invoice_date) AS quarter, SUM(total) AS revenue FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2024 GROUP BY EXTRACT(QUARTER FROM invoice_date)) SELECT quarter, revenue, LAG(revenue) OVER (ORDER BY quarter) AS previous_quarter_revenue FROM quarterly ORDER BY quarter LIMIT 1000"
BENCH-JEV status=200 latency_ms=193 model=jev-1.14.0 input_tokens=2537 output_tokens=21 noul=0.2 q='Which ISO week numbers of 2023 had the highest invoice revenue? Return' sql="SELECT EXTRACT(WEEK FROM invoice_date) AS week_number, SUM(total) AS revenue FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2023 GROUP BY week_number ORDER BY revenue DESC LIMIT 3"
BENCH-JEV status=200 latency_ms=164 model=jev-1.14.0 input_tokens=2473 output_tokens=21 noul=0.76 q='How many distinct billing postal codes appear on invoices billed to Ca' sql="SELECT COUNT(DISTINCT billing_postal_code) AS distinct_postal_codes FROM invoice WHERE billing_country = 'Canada' LIMIT 1000"
