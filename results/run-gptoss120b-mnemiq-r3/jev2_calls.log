BENCH-JEV status=200 latency_ms=126 model=jev-1.14.0 prompt=b input_tokens=2641 output_tokens=21 noul=0.84 q='What percentage of total sales revenue (unit price times quantity) com' sql="SELECT ROUND(100.0 * SUM(CASE WHEN mt.name ILIKE '%video%' THEN il.unit_price * il.quantity ELSE 0 END) / NULLIF(SUM(il.unit_price * il.quantity), 0), 2) AS video_sales_pct FROM invoice_line AS il JOIN track AS t ON il.track_id = t.track_id JOIN media_type AS mt ON t.media_type_id = mt.media_type_id LIMIT 1"
BENCH-JEV status=200 latency_ms=192 model=jev-1.14.0 prompt=b input_tokens=2666 output_tokens=21 noul=0.41 q='For each day of the week in 2024, how many invoices were issued? Retur' sql="SELECT EXTRACT(DAYOFWEEK FROM invoice_date) AS day_of_week, COUNT(*) AS invoice_count FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2024 GROUP BY day_of_week ORDER BY day_of_week LIMIT 1000"
BENCH-JEV status=200 latency_ms=128 model=jev-1.14.0 prompt=b input_tokens=2837 output_tokens=21 noul=0.78 q='For each support representative, which customer has the highest total ' sql="WITH cust_spend AS (SELECT c.customer_id, c.first_name AS cust_first_name, c.last_name AS cust_last_name, c.support_rep_id, COALESCE(SUM(i.total), 0) AS spend FROM customer AS c LEFT JOIN invoice AS i ON c.customer_id = i.customer_id GROUP BY c.customer_id, c.first_name, c.last_name, c.support_rep_id), rep_max AS (SELECT support_rep_id, MAX(spend) AS max_spend FROM cust_spend GROUP BY support_rep_id) SELECT e.first_name AS rep_first_name, e.last_name AS rep_last_name, cs.cust_first_name, cs.cust_last_name, cs.spend FROM cust_spend AS cs JOIN rep_max AS rm ON cs.support_rep_id = rm.support_rep_id AND cs.spend = rm.max_spend JOIN employee AS e ON cs.support_rep_id = e.employee_id ORDER BY e.employee_id LIMIT 1000"
BENCH-JEV status=200 latency_ms=196 model=jev-1.14.0 prompt=b input_tokens=3055 output_tokens=21 noul=0.4 q='Which artists have never had any track appear on an invoice line (neve' sql="SELECT DISTINCT a.name FROM artist AS a LEFT JOIN album AS al ON a.artist_id = al.artist_id LEFT JOIN track AS t ON al.album_id = t.album_id LEFT JOIN invoice_line AS il ON t.track_id = il.track_id WHERE il.track_id IS NULL ORDER BY a.name ASC LIMIT 1000"
BENCH-JEV status=200 latency_ms=147 model=jev-1.14.0 prompt=b input_tokens=2741 output_tokens=21 noul=0.84 q='For each quarter of 2024, show the total invoice revenue and the previ' sql="WITH quarterly AS (SELECT EXTRACT(YEAR FROM invoice_date) AS yr, EXTRACT(QUARTER FROM invoice_date) AS qtr, SUM(total) AS revenue FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2024 GROUP BY EXTRACT(YEAR FROM invoice_date), EXTRACT(QUARTER FROM invoice_date)) SELECT qtr AS quarter, revenue, LAG(revenue) OVER (ORDER BY qtr) AS prev_quarter_revenue FROM quarterly ORDER BY quarter LIMIT 1000"
BENCH-JEV status=200 latency_ms=136 model=jev-1.14.0 prompt=b input_tokens=2633 output_tokens=21 noul=0.83 q='Which ISO week numbers of 2023 had the highest invoice revenue? Return' sql="SELECT CAST(STRFTIME(invoice_date, '%V') AS INT) AS week_number, SUM(total) AS revenue FROM invoice WHERE DATE_PART('year', invoice_date) = 2023 GROUP BY week_number ORDER BY revenue DESC LIMIT 3"
BENCH-JEV status=200 latency_ms=144 model=jev-1.14.0 prompt=b input_tokens=2569 output_tokens=21 noul=0.76 q='How many distinct billing postal codes appear on invoices billed to Ca' sql="SELECT COUNT(DISTINCT billing_postal_code) AS distinct_billing_postal_codes FROM invoice WHERE billing_country = 'Canada' LIMIT 1000"
