BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.97 q='How many tracks are there in each genre? Return the genre name and the' sql="SELECT g.name AS genre_name, COUNT(t.track_id) AS track_count FROM genre AS g LEFT JOIN track AS t ON g.genre_id = t.genre_id GROUP BY g.name ORDER BY g.name LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.93 q='Which 5 artists have the most albums? Return the artist name and album' sql="SELECT a.name, COUNT(al.album_id) AS album_count FROM artist AS a JOIN album AS al ON a.artist_id = al.artist_id GROUP BY a.artist_id, a.name ORDER BY album_count DESC LIMIT 5"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.98 q='What are the total sales (sum of invoice totals) for each billing coun' sql="SELECT billing_country, SUM(total) AS total_sales FROM invoice GROUP BY billing_country ORDER BY total_sales DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.98 q='Which customers are supported by the employee Jane Peacock? Return the' sql="SELECT c.first_name, c.last_name FROM customer AS c JOIN employee AS e ON c.support_rep_id = e.employee_id WHERE e.first_name = 'Jane' AND e.last_name = 'Peacock' LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.97 q='What is the average track length in minutes for each media type? Retur' sql="SELECT mt.name AS media_type_name, AVG(t.milliseconds) / 60000.0 AS avg_minutes FROM track AS t JOIN media_type AS mt ON t.media_type_id = mt.media_type_id GROUP BY mt.name LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.97 q='Which albums have more than 20 tracks? Return the album title and the ' sql="SELECT a.title, COUNT(t.track_id) AS track_count FROM album AS a JOIN track AS t ON t.album_id = a.album_id GROUP BY a.album_id, a.title HAVING COUNT(t.track_id) > 20 ORDER BY track_count DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.96 q='Which genre has the most tracks? Return the genre name.' sql="SELECT g.name FROM genre AS g JOIN track AS t ON g.genre_id = t.genre_id GROUP BY g.genre_id, g.name ORDER BY COUNT(t.track_id) DESC LIMIT 1"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.88 q="How many tracks are in the playlist named '90’s Music'?" sql="SELECT COUNT(*) AS track_count FROM playlist_track AS pt JOIN playlist AS p ON pt.playlist_id = p.playlist_id WHERE p.name = '90\u2019s Music' LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.97 q='What is the total invoice revenue for each year? Return the year and r' sql="SELECT EXTRACT(YEAR FROM invoice_date) AS year, SUM(total) AS revenue FROM invoice GROUP BY EXTRACT(YEAR FROM invoice_date) ORDER BY year LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.96 q='What are the top 3 genres by sales revenue, where revenue is unit pric' sql="SELECT g.name AS genre, SUM(il.unit_price * il.quantity) AS revenue FROM invoice_line AS il JOIN track AS t ON il.track_id = t.track_id JOIN genre AS g ON t.genre_id = g.genre_id GROUP BY g.name ORDER BY revenue DESC LIMIT 3"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.68 q='For each sales support agent, what is the total invoice amount from th' sql="SELECT e.first_name, e.last_name, SUM(i.total) AS total_invoice_amount FROM employee AS e JOIN customer AS c ON e.employee_id = c.support_rep_id JOIN invoice AS i ON c.customer_id = i.customer_id WHERE e.title = 'Sales Support Agent' GROUP BY e.employee_id, e.first_name, e.last_name ORDER BY total_invoice_amount DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.85 q='Which customers have spent more in total than the average total spend ' sql="WITH cust_spend AS (SELECT i.customer_id, SUM(i.total) AS total_spend FROM invoice AS i GROUP BY i.customer_id), avg_spend AS (SELECT AVG(total_spend) AS avg_total FROM cust_spend) SELECT c.first_name, c.last_name, cs.total_spend FROM cust_spend AS cs JOIN customer AS c ON c.customer_id = cs.customer_id CROSS JOIN avg_spend AS a WHERE cs.total_spend > a.avg_total ORDER BY cs.total_spend DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.95 q='For each country, which customer has the highest total spend? Include ' sql="WITH cust_spend AS (SELECT c.customer_id, c.country, c.first_name, c.last_name, SUM(i.total) AS total_spend FROM customer AS c JOIN invoice AS i ON c.customer_id = i.customer_id GROUP BY c.customer_id, c.country, c.first_name, c.last_name), country_max AS (SELECT country, MAX(total_spend) AS max_spend FROM cust_spend GROUP BY country) SELECT cs.country, cs.first_name, cs.last_name, cs.total_spend FROM cust_spend AS cs JOIN country_max AS cm ON cs.country = cm.country AND cs.total_spend = cm.max_spend ORDER BY cs.country, cs.last_name, cs.first_name LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.35 q='For each month of 2024, show the total invoice revenue and the previou' sql="SELECT EXTRACT(MONTH FROM invoice_date) AS month, SUM(total) AS revenue, LAG(SUM(total)) OVER (ORDER BY EXTRACT(MONTH FROM invoice_date)) AS prev_month_revenue FROM invoice WHERE invoice_date >= CAST('2024-01-01' AS TIMESTAMP) AND invoice_date < CAST('2025-01-01' AS TIMESTAMP) GROUP BY EXTRACT(MONTH FROM invoice_date) ORDER BY month LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.75 q='Which artists have tracks in more than 3 different genres? Return the ' sql="SELECT a.name, COUNT(DISTINCT t.genre_id) AS distinct_genres FROM track AS t JOIN album AS al ON t.album_id = al.album_id JOIN artist AS a ON al.artist_id = a.artist_id GROUP BY a.name HAVING COUNT(DISTINCT t.genre_id) > 3 ORDER BY distinct_genres DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.95 q='How many tracks have never been purchased (never appear on any invoice' sql="SELECT COUNT(*) AS never_purchased_count FROM track AS t WHERE NOT EXISTS(SELECT 1 FROM invoice_line AS il WHERE il.track_id = t.track_id) LIMIT 1000"
