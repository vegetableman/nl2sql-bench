BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.93 q='How many customers made at least one purchase in 2025 but made no purc' sql="SELECT COUNT(*) AS customer_count FROM (SELECT i.customer_id, MAX(CASE WHEN EXTRACT(YEAR FROM i.invoice_date) = 2025 THEN 1 ELSE 0 END) AS has_2025, MAX(CASE WHEN EXTRACT(YEAR FROM i.invoice_date) = 2024 THEN 1 ELSE 0 END) AS has_2024 FROM invoice AS i GROUP BY i.customer_id HAVING MAX(CASE WHEN EXTRACT(YEAR FROM i.invoice_date) = 2025 THEN 1 ELSE 0 END) = 1 AND MAX(CASE WHEN EXTRACT(YEAR FROM i.invoice_date) = 2024 THEN 1 ELSE 0 END) = 0) AS sub LIMIT 1000"
