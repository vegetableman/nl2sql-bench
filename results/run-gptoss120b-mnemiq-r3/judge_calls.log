BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.92 q='How many customers made at least one purchase in 2025 but made no purc' sql="SELECT COUNT(DISTINCT c.customer_id) AS customer_count FROM customer AS c JOIN invoice AS i ON c.customer_id = i.customer_id WHERE EXTRACT(YEAR FROM i.invoice_date) = 2025 AND NOT c.customer_id IN (SELECT customer_id FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2024) LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.9 q='For each month of 2023, show the year-to-date running total of invoice' sql="SELECT month, SUM(month_total) OVER (ORDER BY month) AS running_total FROM (SELECT CAST(DATE_TRUNC('MONTH', invoice_date) AS DATE) AS month, SUM(total) AS month_total FROM invoice WHERE invoice_date >= '2023-01-01' AND invoice_date < '2024-01-01' GROUP BY CAST(DATE_TRUNC('MONTH', invoice_date) AS DATE)) AS t ORDER BY month LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.82 q='What percentage of total sales revenue (unit price times quantity) com' sql="SELECT sub.name, ROUND(100.0 * sub.revenue / total.total_revenue, 2) AS percentage FROM (SELECT mt.media_type_id, mt.name, SUM(il.unit_price * il.quantity) AS revenue FROM invoice_line AS il JOIN track AS t ON il.track_id = t.track_id JOIN media_type AS mt ON t.media_type_id = mt.media_type_id GROUP BY mt.media_type_id, mt.name) AS sub CROSS JOIN (SELECT SUM(il.unit_price * il.quantity) AS total_revenue FROM invoice_line AS il) AS total ORDER BY percentage DESC LIMIT 1000"
