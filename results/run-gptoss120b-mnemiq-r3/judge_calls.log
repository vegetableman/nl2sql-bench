BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.95 q='For each sales support agent, what is the total invoice amount from th' sql="SELECT e.first_name, e.last_name, COALESCE(SUM(i.total), 0) AS total FROM employee AS e LEFT JOIN customer AS c ON c.support_rep_id = e.employee_id LEFT JOIN invoice AS i ON i.customer_id = c.customer_id WHERE e.title = 'Sales Support Agent' GROUP BY e.employee_id, e.first_name, e.last_name ORDER BY total DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.96 q='Which customers have spent more in total than the average total spend ' sql="WITH cust_totals AS (SELECT c.customer_id, c.first_name, c.last_name, COALESCE(SUM(i.total), 0) AS total_spent FROM customer AS c LEFT JOIN invoice AS i ON i.customer_id = c.customer_id GROUP BY c.customer_id, c.first_name, c.last_name), avg_total AS (SELECT AVG(total_spent) AS avg_spent FROM cust_totals) SELECT ct.first_name, ct.last_name, ct.total_spent FROM cust_totals AS ct, avg_total AS a WHERE ct.total_spent > a.avg_spent ORDER BY ct.total_spent DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.95 q='For each country, which customer has the highest total spend? Include ' sql="WITH cust_spend AS (SELECT c.country, c.first_name, c.last_name, c.customer_id, SUM(i.total) AS total_spend FROM customer AS c JOIN invoice AS i ON i.customer_id = c.customer_id GROUP BY c.country, c.first_name, c.last_name, c.customer_id), ranked AS (SELECT country, first_name, last_name, total_spend, DENSE_RANK() OVER (PARTITION BY country ORDER BY total_spend DESC) AS rnk FROM cust_spend) SELECT country, first_name, last_name, total_spend FROM ranked WHERE rnk = 1 ORDER BY country LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.6 q='For each month of 2024, show the total invoice revenue and the previou' sql="WITH monthly AS (SELECT CAST(EXTRACT(MONTH FROM invoice_date) AS INT) AS month, SUM(total) AS revenue FROM invoice WHERE CAST(EXTRACT(YEAR FROM invoice_date) AS INT) = 2024 GROUP BY month) SELECT month, revenue, LAG(revenue) OVER (ORDER BY month) AS prev_month_revenue FROM monthly ORDER BY month LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.9 q='Which artists have tracks in more than 3 different genres? Return the ' sql="SELECT a.name AS artist_name, COUNT(DISTINCT t.genre_id) AS genre_count FROM track AS t JOIN album AS al ON t.album_id = al.album_id JOIN artist AS a ON al.artist_id = a.artist_id GROUP BY a.name HAVING COUNT(DISTINCT t.genre_id) > 3 ORDER BY genre_count DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.95 q='How many tracks have never been purchased (never appear on any invoice' sql="SELECT COUNT(*) AS never_purchased_tracks FROM track AS t LEFT JOIN invoice_line AS il ON t.track_id = il.track_id WHERE il.track_id IS NULL LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.93 q='List every employee together with the name of the manager they report ' sql="SELECT e.first_name AS employee_first_name, e.last_name AS employee_last_name, m.first_name AS manager_first_name, m.last_name AS manager_last_name FROM employee AS e JOIN employee AS m ON e.reports_to = m.employee_id LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.9 q='How many customers made at least one purchase in 2025 but made no purc' sql="SELECT COUNT(DISTINCT customer_id) AS customer_count FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2025 AND NOT customer_id IN (SELECT DISTINCT customer_id FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2024) LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.78 q='For each month of 2023, show the year-to-date running total of invoice' sql="SELECT CAST(month AS TEXT) AS month, SUM(month_total) OVER (ORDER BY month ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total FROM (SELECT DATE_TRUNC('MONTH', invoice_date) AS month, SUM(total) AS month_total FROM invoice WHERE invoice_date >= CAST('2023-01-01 00:00:00' AS TIMESTAMP) AND invoice_date < CAST('2024-01-01 00:00:00' AS TIMESTAMP) GROUP BY DATE_TRUNC('MONTH', invoice_date)) AS monthly ORDER BY month LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.85 q='What percentage of total sales revenue (unit price times quantity) com' sql="WITH total AS (SELECT SUM(unit_price * quantity) AS total_revenue FROM invoice_line), per_media AS (SELECT mt.media_type_id, mt.name, SUM(il.unit_price * il.quantity) AS revenue FROM invoice_line AS il JOIN track AS t ON il.track_id = t.track_id JOIN media_type AS mt ON t.media_type_id = mt.media_type_id GROUP BY mt.media_type_id, mt.name) SELECT pm.name, ROUND(100.0 * pm.revenue / total.total_revenue, 2) AS percentage FROM per_media AS pm CROSS JOIN total ORDER BY percentage DESC LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.95 q='Which 5 artists generated the most sales revenue (unit price times qua' sql="SELECT a.name AS artist_name, SUM(il.unit_price * il.quantity) AS revenue FROM invoice_line AS il JOIN track AS t ON il.track_id = t.track_id JOIN album AS al ON t.album_id = al.album_id JOIN artist AS a ON al.artist_id = a.artist_id GROUP BY a.name ORDER BY revenue DESC LIMIT 5"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.9 q='How many distinct media types are there?' sql="SELECT COUNT(*) AS distinct_media_type_count FROM media_type LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.9 q='How many customers have a fax number recorded?' sql="SELECT COUNT(*) AS customers_with_fax FROM customer WHERE NOT fax IS NULL AND fax <> '' LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.97 q='How many tracks are larger than 15 megabytes (bytes > 15 * 1024 * 1024' sql="SELECT COUNT(*) AS track_count FROM track WHERE bytes > 15728640 LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.95 q='How many invoices have a billing address that contains the word Street' sql="SELECT COUNT(*) AS invoice_count FROM invoice WHERE billing_address ILIKE '%Street%' LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.97 q='What is the average track file size in bytes for each media type? Retu' sql="SELECT mt.name AS media_type_name, AVG(t.bytes) AS average_bytes FROM track AS t JOIN media_type AS mt USING (media_type_id) GROUP BY mt.name ORDER BY mt.name LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.9 q='How many playlists contain tracks from at least 10 different genres?' sql="SELECT COUNT(*) AS playlist_count FROM (SELECT pt.playlist_id FROM playlist_track AS pt JOIN track AS t ON pt.track_id = t.track_id GROUP BY pt.playlist_id HAVING COUNT(DISTINCT t.genre_id) >= 10) AS sub LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.94 q='List employees born in the 1970s. Return first name, last name and bir' sql="SELECT first_name, last_name, birth_date FROM employee WHERE birth_date >= '1970-01-01' AND birth_date < '1980-01-01' ORDER BY birth_date LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.98 q="How many customers have a phone number that starts with '+55'?" sql="SELECT COUNT(*) AS customer_count FROM customer WHERE phone LIKE '+55%' LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.95 q='What percentage of total sales revenue (unit price times quantity) com' sql="SELECT ROUND((SUM(CASE WHEN LOWER(mt.name) LIKE '%video%' THEN il.unit_price * il.quantity ELSE 0 END) / NULLIF(SUM(il.unit_price * il.quantity), 0)) * 100, 2) AS video_revenue_pct FROM invoice_line AS il JOIN track AS t ON il.track_id = t.track_id JOIN media_type AS mt ON t.media_type_id = mt.media_type_id LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.72 q='For each day of the week in 2024, how many invoices were issued? Retur' sql="SELECT EXTRACT(DAYOFWEEK FROM invoice_date) AS day_of_week, COUNT(*) AS invoice_count FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2024 GROUP BY EXTRACT(DAYOFWEEK FROM invoice_date) ORDER BY day_of_week LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.85 q='For each support representative, which customer has the highest total ' sql="WITH cust_spend AS (SELECT c.customer_id, c.first_name AS cust_first, c.last_name AS cust_last, c.support_rep_id, SUM(i.total) AS spend FROM customer AS c JOIN invoice AS i ON c.customer_id = i.customer_id GROUP BY c.customer_id, c.first_name, c.last_name, c.support_rep_id), ranked AS (SELECT cs.*, MAX(cs.spend) OVER (PARTITION BY cs.support_rep_id) AS max_spend FROM cust_spend AS cs) SELECT e.first_name AS rep_first_name, e.last_name AS rep_last_name, r.cust_first AS customer_first_name, r.cust_last AS customer_last_name, r.spend FROM ranked AS r JOIN employee AS e ON r.support_rep_id = e.employee_id WHERE r.spend = r.max_spend ORDER BY e.employee_id, r.cust_last, r.cust_first LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.92 q='Which artists have never had any track appear on an invoice line (neve' sql="SELECT a.name FROM artist AS a WHERE NOT EXISTS(SELECT 1 FROM album AS al JOIN track AS t ON t.album_id = al.album_id WHERE al.artist_id = a.artist_id AND EXISTS(SELECT 1 FROM invoice_line AS il WHERE il.track_id = t.track_id)) ORDER BY a.name LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.1 q='For each quarter of 2024, show the total invoice revenue and the previ' sql="WITH q AS (SELECT ((MONTH(invoice_date) - 1) / 3) + 1 AS quarter, SUM(total) AS revenue FROM invoice WHERE YEAR(invoice_date) = 2024 GROUP BY 1) SELECT q.quarter, q.revenue, prev.revenue AS previous_quarter_revenue FROM q LEFT JOIN q AS prev ON prev.quarter = q.quarter - 1 ORDER BY q.quarter LIMIT 1000"
BENCH-JUDGE max_tokens=1200 reply_chars=19 conf=0.3 q='Which ISO week numbers of 2023 had the highest invoice revenue? Return' sql="SELECT EXTRACT(WEEK FROM invoice_date) AS week_number, SUM(total) AS revenue FROM invoice WHERE EXTRACT(YEAR FROM invoice_date) = 2023 GROUP BY week_number ORDER BY revenue DESC LIMIT 3"
