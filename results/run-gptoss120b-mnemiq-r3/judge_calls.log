BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.96 q='What percentage of total sales revenue (unit price times quantity) com' sql="SELECT ROUND((video_rev.total_video_rev / overall.total_rev) * 100, 2) AS percentage_video_sales FROM (SELECT SUM(il.unit_price * il.quantity) AS total_rev FROM invoice_line AS il) AS overall CROSS JOIN (SELECT SUM(il.unit_price * il.quantity) AS total_video_rev FROM invoice_line AS il JOIN track AS t ON il.track_id = t.track_id JOIN media_type AS mt ON t.media_type_id = mt.media_type_id WHERE LOWER(mt.name) LIKE '%video%') AS video_rev LIMIT 1000"
