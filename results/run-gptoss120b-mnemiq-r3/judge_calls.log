BENCH-JUDGE max_tokens=1200 reply_chars=20 conf=0.86 q='For each country, which customer has the highest total spend? Include ' sql="WITH customer_spend AS (SELECT c.customer_id, c.country, c.first_name, c.last_name, COALESCE(SUM(i.total), 0) AS total_spend FROM customer AS c LEFT JOIN invoice AS i ON i.customer_id = c.customer_id GROUP BY c.customer_id, c.country, c.first_name, c.last_name), ranked AS (SELECT country, first_name, last_name, total_spend, MAX(total_spend) OVER (PARTITION BY country) AS max_spend FROM customer_spend) SELECT country, first_name, last_name, total_spend FROM ranked WHERE total_spend = max_spend ORDER BY country, last_name, first_name LIMIT 1000"
