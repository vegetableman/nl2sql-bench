# ---- LLM (shared by WrenAI and DB-GPT for fairness) ----
# REQUIRED for real runs. Never commit the real value. Key for LLM_UPSTREAM_BASE
# (Ollama Cloud key, or an OpenAI key if LLM_UPSTREAM_BASE=https://api.openai.com/v1).
LLM_API_KEY=
# Chat model used by ALL systems
LLM_MODEL=gpt-oss:120b
# Upstream OpenAI-compatible endpoint (both tools go through the local llm-meter proxy,
# which forwards here and counts tokens). e.g. https://api.groq.com/openai/v1, https://openrouter.ai/api/v1
LLM_UPSTREAM_BASE=https://ollama.com/v1
LLM_CONTEXT_WINDOW=128000
# Embedding model used by BOTH tools (schema retrieval) + its vector dim
# Ollama Cloud has no embeddings API -> local ollama container (nomic-embed-text, 768-d).
# For OpenAI: text-embedding-3-small / 1536 / https://api.openai.com/v1 and STRIP_AUTH_FOR_EMBEDDINGS=0
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_UPSTREAM_BASE=http://ollama:11434/v1
STRIP_AUTH_FOR_EMBEDDINGS=1

# ---- Target database (both tools + harness connect here) ----
# Defaults point at the bundled Chinook Postgres container (docker network alias "bench-postgres").
# To use another Postgres, change these (host must be reachable FROM containers;
# use host.docker.internal for a DB on this machine) and supply a matching questions file.
BENCH_PG_HOST=bench-postgres
BENCH_PG_PORT=5432
BENCH_PG_DB=chinook
BENCH_PG_USER=bench
BENCH_PG_PASSWORD=bench
# How the harness (running on the host) reaches the same DB
BENCH_DB_URL=postgresql://bench:bench@localhost:5432/chinook

# ---- Host ports ----
PG_HOST_PORT=5432
WREN_UI_PORT=3000
WREN_AI_PORT=5555
DBGPT_PORT=5670
METER_PORT=8089
CUBE_PORT=4000
# HS256 secret for Cube REST API JWTs (local only)
CUBEJS_API_SECRET=nl2sql-bench-local-secret
# Second WrenAI stack (semantic layer / MDL project)
WREN_MDL_UI_PORT=3001
WREN_MDL_AI_PORT=5556

# cube_v2 (rich model + SQL API)
CUBE_V2_PORT=4001
CUBE_V2_SQL_PORT=15432
CUBE_SQL_USER=cube
CUBE_SQL_PASSWORD=cube-local
