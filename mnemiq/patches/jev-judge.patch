diff --git a/src/mnemiq/verify/judge.py b/src/mnemiq/verify/judge.py
index 0811e21..716b070 100644
--- a/src/mnemiq/verify/judge.py
+++ b/src/mnemiq/verify/judge.py
@@ -107,6 +107,134 @@ class SemanticJudge:
         return self.read(question, schema, sql, preview).score
 
 
+class JevJudge:
+    """nl2sql-bench patch: the judge as one TypeSafe Jev `noul` question (POST /v1/systemone).
+
+    Same interface and counters as `SemanticJudge`: `read(question, schema, sql, preview) -> JudgeRead`,
+    `score(...)`, `calls` / `errors` / `unparsed`. Score = the noul probability. An API error (transport,
+    non-200, 429) -> JudgeRead(1.0, fell_open=True, reason="error"); a 200 whose body carries no readable
+    noul -> reason="unparsed". The Verifier's fail-closed handling and 0.5 threshold are untouched.
+    The API key is read from TYPESAFE_API_KEY and is never logged.
+    """
+
+    _URL = "https://api.typesafe.ai/v1/systemone"
+    _QID = "answers_question"
+    # MNEMIQ_JEV_PROMPT selects the request shape (offline comparison: results/judge-comparison/):
+    #   v1 -- original: state {question, schema, sql, result}, "does `result` completely answer" (5-row preview)
+    #   a  -- + result_total_rows / result_rows_shown / result_preview_truncated (+ note), SQL-logic instruction, 5 rows
+    #   b  -- as a, 50-row sample (DEFAULT);  c -- as a, full result up to 250 rows (50 if it would exceed ~20k tokens)
+    _PREVIEW_ROWS = {"v1": 5, "a": 5, "b": 50, "c": 250}
+    _INSTRUCTIONS_SQL = ("`sql` was run against the database described by `schema` and returned `result`, which shows "
+                         "`result_rows_shown` of `result_total_rows` rows. Judge the SQL logic, not the completeness of the "
+                         "shown rows: when `result_preview_truncated` is true the other rows exist but are not shown. Does "
+                         "`sql` correctly answer `question`, given `schema`? Check the right tables and joins, every filter "
+                         "the question implies, the right aggregation and grain, and the ordering and limit the question "
+                         "asks for. A plausible-looking number can still be wrong.")
+    _INSTRUCTIONS = ("`sql` was run and returned `result`. Does `result` correctly and completely answer "
+                     "`question`, given `schema`? Check the right tables and joins, every filter the question "
+                     "implies, and the right aggregation and grain. A plausible-looking number can still be wrong.")
+
+    def __init__(self, model: str | None = None, timeout_s: float = 60.0) -> None:
+        import os
+        self._key = os.environ.get("TYPESAFE_API_KEY", "")
+        self._model = model or os.environ.get("MNEMIQ_JEV_MODEL", "jev-1.14.0")
+        self._timeout = timeout_s
+        self.prompt = os.environ.get("MNEMIQ_JEV_PROMPT", "b")  # default chosen offline (judge_variants.md); v1 = original
+        if self.prompt not in self._PREVIEW_ROWS:
+            raise ValueError(f"MNEMIQ_JEV_PROMPT={self.prompt!r}; valid: {sorted(self._PREVIEW_ROWS)}")
+        self.preview_rows = self._PREVIEW_ROWS[self.prompt]  # read by the Verifier when it renders the result
+        self.calls = 0
+        self.errors = 0
+        self.unparsed = 0
+
+    @property
+    def fallbacks(self) -> int:
+        return self.errors + self.unparsed
+
+    @staticmethod
+    def _counts(preview: str):
+        """(rows shown, total rows, truncated) from render_result's own footer line."""
+        import re
+        last = preview.strip().splitlines()[-3:] if preview else []
+        for line in reversed(last):
+            m = re.match(r"\.\.\. showing (\d+) of (\d+) rows \(truncated\)", line)
+            if m:
+                return int(m[1]), int(m[2]), True
+            m = re.match(r"\((\d+) rows\)$", line)
+            if m:
+                return int(m[1]), int(m[1]), False
+            m = re.match(r"\.\.\. showing (\d+) rows; the query stopped", line)
+            if m:
+                return int(m[1]), None, True
+        return None, None, None
+
+    def request_body(self, question: str, schema: str, sql: str, preview: str) -> dict:
+        if self.prompt == "v1":
+            return {"model": self._model,
+                    "state": {"question": question, "schema": schema, "sql": sql, "result": preview},
+                    "questions": {self._QID: {"type": "noul", "instructions": self._INSTRUCTIONS}}}
+        if self.prompt == "c" and len(preview) > 80_000:  # ~20k tokens: keep well inside the 32k/question limit
+            lines = preview.splitlines()
+            shown, total, _ = self._counts(preview)
+            preview = "\n".join(lines[:51] + [f"... showing 50 of {total} rows (truncated)"])
+        shown, total, truncated = self._counts(preview)
+        state = {"question": question, "schema": schema, "sql": sql, "result": preview,
+                 "result_rows_shown": shown, "result_total_rows": total, "result_preview_truncated": truncated}
+        if truncated:
+            state["note"] = ("preview_truncated: true -- judge the correctness of the SQL logic, "
+                             "not the completeness of the preview")
+        return {"model": self._model, "state": state,
+                "questions": {self._QID: {"type": "noul", "instructions": self._INSTRUCTIONS_SQL}}}
+
+    def read(self, question: str, schema: str, sql: str, preview: str) -> "JudgeRead":
+        import json, logging, time, urllib.error, urllib.request
+        self.calls += 1
+        log = logging.getLogger("mnemiq.bench")
+        body = json.dumps(self.request_body(question, schema, sql, preview)).encode()
+        req = urllib.request.Request(self._URL, data=body, method="POST", headers={
+            "Authorization": f"Bearer {self._key}", "Content-Type": "application/json"})
+        t0 = time.perf_counter()
+        status, payload = None, None
+        try:
+            with urllib.request.urlopen(req, timeout=self._timeout) as resp:
+                status = resp.status
+                payload = json.loads(resp.read().decode())
+        except urllib.error.HTTPError as e:
+            status = e.code
+            detail = e.read().decode(errors="replace")[:300]
+            self.errors += 1
+            log.warning("BENCH-JEV status=%s latency_ms=%.0f error=%s q=%r sql=%s", status,
+                        (time.perf_counter() - t0) * 1000, json.dumps(detail), question[:70], json.dumps(sql))
+            return JudgeRead(1.0, fell_open=True, reason="error")
+        except Exception as e:
+            self.errors += 1
+            log.warning("BENCH-JEV status=None latency_ms=%.0f error=%s q=%r sql=%s",
+                        (time.perf_counter() - t0) * 1000, json.dumps(type(e).__name__), question[:70], json.dumps(sql))
+            return JudgeRead(1.0, fell_open=True, reason="error")
+        ms = (time.perf_counter() - t0) * 1000
+        try:
+            ans = payload["answers"][self._QID]
+            if ans.get("type") != "noul":
+                raise ValueError("answer type")
+            p = float(ans["noul"])
+            if not 0.0 <= p <= 1.0:
+                raise ValueError("range")
+        except Exception:
+            self.unparsed += 1
+            log.warning("BENCH-JEV status=%s latency_ms=%.0f unparsed keys=%s q=%r sql=%s", status, ms,
+                        json.dumps(sorted(payload) if isinstance(payload, dict) else str(type(payload))),
+                        question[:70], json.dumps(sql))
+            return JudgeRead(1.0, fell_open=True, reason="unparsed")
+        usage = payload.get("usage") or {}
+        log.warning("BENCH-JEV status=%s latency_ms=%.0f model=%s prompt=%s input_tokens=%s output_tokens=%s noul=%s q=%r sql=%s",
+                    status, ms, payload.get("model"), self.prompt, usage.get("input_tokens"), usage.get("output_tokens"), p,
+                    question[:70], json.dumps(sql))
+        return JudgeRead(p, fell_open=False)
+
+    def score(self, question: str, schema: str, sql: str, preview: str) -> float:
+        return self.read(question, schema, sql, preview).score
+
+
 class FakeJudge:
     """Fixed score, zero tokens -- for tests and offline replay of a scripted operating point."""
 
